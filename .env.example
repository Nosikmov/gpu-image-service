# --- GPU Image Service ---
APP_ENV=production
LOG_LEVEL=INFO
ENABLE_DOCS=false
PRIVACY_MODE=true

# Required: shared secret for game server → GPU API
API_KEY=change-me-to-a-long-random-string

API_HOST=0.0.0.0
API_PORT=8080
COMFYUI_PORT=8188

# CORS: * or comma-separated origins
CORS_ORIGINS=*

REDIS_URL=redis://redis:6379/0
JOB_QUEUE_KEY=gis:jobs:queue
JOB_TTL_SEC=604800
STUCK_JOB_TIMEOUT_SEC=900
MAX_RETRIES=2

COMFYUI_URL=http://comfyui:8188
COMFYUI_TIMEOUT_SEC=600

# Host paths (mounted into containers). Keep outside git.
MODELS_PATH=./data/models
GENERATED_PATH=./data/generated
WORKFLOWS_PATH=/app/workflows

SAVE_PNG=false
DEFAULT_WIDTH=768
DEFAULT_HEIGHT=768
DEFAULT_STEPS=20
DEFAULT_CFG=7.0
DEFAULT_FORMAT=webp
IMAGE_QUALITY=90

MAX_WIDTH=1536
MAX_HEIGHT=1536
MAX_STEPS=50
MAX_BATCH_SIZE=1
MAX_PROMPT_LENGTH=4000

ALLOWED_WORKFLOWS=sdxl
DEFAULT_WORKFLOW=sdxl
DEFAULT_MODEL=sd_xl_base_1.0.safetensors

WORKER_ID=worker-1
WORKER_HEARTBEAT_TTL_SEC=30
